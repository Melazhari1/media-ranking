{
    "name": "melazhari/mediarank",
    "description": "MMR - My Media Ranking",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "symfony/console": "^6.4",
        "symfony/dotenv": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Migrations\\": "migrations/"
        },
        "classmap": ["MediaManager.php", "Database.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php bin/lint.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
