# Copy to .env (never commit .env). Real environment variables override these values.
# If DB_* are not set here, the constants in config.php are used.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostinger_mediarank
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Phase 2 — server-side only, never sent to the browser
TMDB_API_KEY=
